---
import Layout from '../../layouts/Layout.astro';
import SourcesOfficielles from '../../components/ui/SourcesOfficielles.astro';
import FAQAccordion from '../../components/ui/FAQAccordion.astro';
import { TAX_YEAR } from '../../lib/constants';

const title = `Tax & Finance Guides ${TAX_YEAR}: How US Taxes & Payroll Work`;
const description = `Comprehensive guides to understanding US taxes, paychecks, retirement accounts, and personal finance in ${TAX_YEAR}. Learn about deductions, FICA, brackets, and more.`;

const guides = [
  {
    title: 'How Paychecks Work in the US',
    href: '/guides/how-paychecks-work-in-the-us/',
    desc: 'A complete breakdown of every deduction on your pay stub, from federal tax to FICA to 401(k).',
    category: 'Basics',
  },
  {
    title: `Federal Tax Brackets ${TAX_YEAR}`,
    href: '/guides/federal-tax-brackets-2026/',
    desc: 'The seven federal income tax brackets for all filing statuses, with examples and effective rate calculations.',
    category: 'Federal Tax',
  },
  {
    title: 'State Tax Comparison',
    href: '/guides/state-tax-comparison/',
    desc: 'Compare income tax rates across all 50 states. See which states have no tax, flat tax, and the highest rates.',
    category: 'State Tax',
  },
  {
    title: '401(k) vs Roth IRA',
    href: '/guides/401k-vs-roth-ira/',
    desc: 'Traditional 401(k) vs Roth IRA: tax treatment, contribution limits, employer match, and which is right for you.',
    category: 'Retirement',
  },
  {
    title: 'W-4 Form Explained',
    href: '/guides/w-4-explained/',
    desc: 'How to fill out the post-2020 W-4 form correctly. Steps 1-4, dependents, multiple jobs, and common mistakes.',
    category: 'Federal Tax',
  },
  {
    title: 'Self-Employment Tax Explained',
    href: '/guides/self-employment-tax-explained/',
    desc: '1099 workers and freelancers: how SE tax works, the 15.3% rate, quarterly payments, and deductions.',
    category: 'Self-Employment',
  },
  {
    title: 'Moving to a No-Income-Tax State',
    href: '/guides/moving-to-a-no-income-tax-state/',
    desc: 'Is moving to Texas, Florida, or another no-tax state worth it? Total tax burden analysis beyond income tax.',
    category: 'State Tax',
  },
  {
    title: `Maximum 401(k) Contribution ${TAX_YEAR}`,
    href: '/guides/maximum-401k-contribution-2026/',
    desc: 'Contribution limits for 401(k), 403(b), and 457(b) plans. Employee, employer, and catch-up limits.',
    category: 'Retirement',
  },
  {
    title: 'Understanding Property Tax',
    href: '/guides/understanding-property-tax/',
    desc: 'How property tax is calculated, assessment ratios, homestead exemptions, and appealing your assessment.',
    category: 'Property Tax',
  },
  {
    title: 'Sales Tax Explained',
    href: '/guides/sales-tax-explained/',
    desc: 'State and local sales tax rates, exemptions for groceries and clothing, and sales tax holidays.',
    category: 'Sales Tax',
  },
  {
    title: 'Tax Deductions vs Credits',
    href: '/guides/tax-deductions-vs-credits/',
    desc: 'The fundamental difference between deductions and credits, and why a $1,000 credit is worth more than a $1,000 deduction.',
    category: 'Federal Tax',
  },
  {
    title: `Tax Season Checklist ${TAX_YEAR}`,
    href: '/guides/tax-season-checklist-2026/',
    desc: 'Everything you need to file your taxes: documents, deadlines, common deductions, and step-by-step preparation.',
    category: 'Tax Season',
  },
];
// §7 : une page pilier porte six à huit questions. Celles-ci sont les questions
// que le lecteur pose avant de choisir un guide.
const faqs = [
  {
    question: `Who writes these guides?`,
    answer: `Radif Partners, which publishes TrueTakeHomePay. The figures come from the IRS revenue procedures, the Social Security Administration and the revenue departments of the states concerned, and each guide names the source of any rate it quotes. Where a rule is genuinely contested or pending, the guide says so rather than choosing a side, and each page carries the date of its last real check rather than the date it was served.`,
  },
  {
    question: `Are these guides tax advice?`,
    answer: `No. They describe how the rules generally work and what the published rates are, which is the part that applies to everyone. What they cannot do is weigh your own circumstances: a diagnosed situation, a partnership, an unusual residency, a trust or a business structure all change the answer. Where a guide and a professional who has seen your paperwork disagree, the professional is the one to follow.`,
  },
  {
    question: `Which guide should I read first?`,
    answer: `Whichever matches the question in front of you. If you have just started a job, the guide to how paychecks work and the W-4 walkthrough between them cover the first payslip. If you are filing, the tax season checklist and the piece on deductions against credits do most of the work. If you are weighing a move, the state comparison and the no-income-tax guide are the pair to read together.`,
  },
  {
    question: `How often are the guides updated?`,
    answer: `When the underlying figures change, which for brackets, contribution limits and the Social Security wage base means annually in the autumn for the following year, and at any point when a rule is amended. Nothing here is rewritten simply to refresh a date: a guide that has not needed changing keeps the date it was last genuinely checked, which is the date shown on the page.`,
  },
  {
    question: `Do these guides cover state taxes as well as federal?`,
    answer: `Both. Federal rules are the same everywhere and take up most of the space, but the state layer is where take-home pay actually differs, from nothing in nine states to more than thirteen per cent in California, plus city taxes in New York, Philadelphia and much of Ohio. The state comparison guide covers the whole picture, and the individual calculators give the figure for one state at a time.`,
  },
  {
    question: `Can I use these figures for my own tax return?`,
    answer: `As a check, yes; as a substitute for the forms, no. The rates and thresholds quoted here are the published ones, so a guide is a good way to see whether a number on a return looks plausible. The return itself depends on documents only you hold, W-2s, 1099s, records of estimated payments, and on choices such as filing status that the guides can explain but not make for you.`,
  },
];

// §21 : un paragraphe qui se suffit à lui-même, servi haut dans la page.
const resumeCitable = `These guides cover the part of the US tax and pay system that applies to everyone, in the order most people meet it: how a payslip is built and why net pay is so much lower than salary, how to fill in a W-4 so that April holds no surprises, what the federal brackets actually do, and how the state layer changes the answer from nothing in nine states to more than thirteen per cent in California. Alongside those sit the pieces on self-employment tax, deductions against credits, property and sales tax, retirement contribution limits, and a filing checklist. Every rate quoted comes from the IRS, the Social Security Administration or a named state revenue department, each page carries the date it was last genuinely checked, and none of it substitutes for a professional who has seen your own paperwork.`;

---

<Layout title={title} description={description}>
  <section class="bg-gradient-to-b from-navy-50 to-white px-4 pb-12 pt-10 dark:from-slate-900 dark:to-slate-950 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl text-center">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">
        Tax &amp; Finance Guides
      </h1>
      <p class="not-prose my-6 rounded-xl border-l-4 border-navy-600 bg-slate-50 p-4 text-base leading-relaxed text-slate-700 dark:border-navy-400 dark:bg-slate-900 dark:text-slate-300">
        {resumeCitable}
      </p>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600 dark:text-slate-400">
        Clear, practical guides to understanding US taxes, paychecks, and personal finance. No jargon, no fluff.
      </p>
    </div>
  </section>

  <section class="px-4 pb-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <div class="grid gap-6 sm:grid-cols-2">
        {guides.map((guide) => (
          <a
            href={guide.href}
            class="group rounded-xl border border-slate-200 bg-white p-6 transition-all hover:border-navy-300 hover:shadow-md dark:border-slate-700 dark:bg-slate-800 dark:hover:border-navy-600"
          >
            <span class="inline-block rounded-full bg-navy-50 px-3 py-1 text-xs font-medium text-navy-700 dark:bg-navy-900/30 dark:text-navy-300">
              {guide.category}
            </span>
            <h2 class="mt-3 text-lg font-semibold text-slate-900 group-hover:text-navy-700 dark:text-white dark:group-hover:text-navy-400">
              {guide.title}
            </h2>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
              {guide.desc}
            </p>
          </a>
        ))}
      </div>
    </div>

    <div class="mx-auto mt-12 max-w-3xl px-4">
      <FAQAccordion faqs={faqs} />
    </div>
  </section>

  <!-- §7 : les sources officielles, avec leur lien -->
  <section class="border-t border-slate-200 px-4 py-8 dark:border-slate-800 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <SourcesOfficielles intro="Figures on this page come from the following official publications:" />
    </div>
  </section>
</Layout>
